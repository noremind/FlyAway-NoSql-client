# Public backend API URL used in production builds.
# Keep the /api suffix.
SERVER_URL=https://api.example.com/api

# Local backend target for Nuxt dev mode.
# Nuxt will normalize this to /api internally.
NUXT_DEV_API_TARGET=http://localhost:3001

# Optional explicit proxy target for local/dev environments.
NUXT_API_PROXY_TARGET=http://localhost:3001

# Public browser key for Yandex Maps.
# Do not put private keys here.
NUXT_PUBLIC_YANDEX_MAPS_API_KEY=your_yandex_maps_public_key
